{
  "id": "mandate-review",
  "name": "委托边界核对",
  "version": "1.0.0",
  "description": "固定输入条件和权限，输出可复查的委托摘要。",
  "capabilities": [
    "read_conditions"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "domain": {
        "enum": [
          "museum",
          "garden",
          "aquarium",
          "buffet",
          "teatime",
          "picnic",
          "citywalk",
          "daytrip",
          "hotel",
          "pottery",
          "cleaning",
          "organizing"
        ]
      },
      "quantity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "fulfillment": {
        "enum": [
          "pickup",
          "shipping",
          "onsite",
          "entry",
          "dine_in",
          "meetup",
          "stay"
        ]
      },
      "budget_yuan": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      }
    },
    "required": [
      "domain",
      "quantity",
      "fulfillment",
      "budget_yuan"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "digest": {
        "type": "string"
      },
      "allowed_actions": {
        "type": "array"
      }
    },
    "required": [
      "digest",
      "allowed_actions"
    ]
  },
  "required_capabilities": [
    "read_conditions"
  ]
}
